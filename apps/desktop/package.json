{
  "name": "@frequencia/desktop",
  "version": "0.12.2",
  "private": true,
  "description": "Dispeaker para desktop",
  "author": "Dispeaker",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsup && electron .",
    "build": "tsup",
    "package": "node ../../scripts/fetch-ffmpeg.mjs && node ../../scripts/build-native.mjs && tsup && electron-builder --win --x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@frequencia/shared": "workspace:*",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "tsup": "^8.5.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "org.dispeaker.desktop",
    "productName": "Dispeaker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "static/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "vendor/capture",
        "to": "capture"
      },
      {
        "from": "vendor/host",
        "to": "host"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Dispeaker-Setup-${version}.exe",
      "shortcutName": "Dispeaker",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "uninstallDisplayName": "Dispeaker",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://dispeaker.duckdns.org/download/"
      }
    ]
  }
}
